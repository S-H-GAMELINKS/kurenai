 }
 
+/* picoruby-kernel: TCPSocket_connect with its two waits taken out.
+ *
+ * That one resolves a host name itself and then spins until the handshake
+ * finishes, which suits a microcontroller with one program on it. Here the
+ * caller is a syscall: the name was resolved by the C library before connect
+ * was ever called, and a spin inside a syscall holds the only VM while the
+ * handshake it is waiting for needs the network pumped by that same VM. So
+ * this sends the SYN and returns, leaving sock->state at CONNECTING; the
+ * connected and error callbacks move it on, and whoever asked comes back to
+ * look. */
+bool
+TCPSocket_connect_start(picorb_state *vm, picorb_socket_t *sock, const void *ip, int port)
+{
+  if (!sock || !ip || port <= 0 || port > 65535) return false;
+
+  if (!sock->pcb && !TCPSocket_create(vm, sock)) return false;
+
+  altcp_recv(sock->pcb, tcp_recv_callback);
+  altcp_sent(sock->pcb, tcp_sent_callback);
+  altcp_err(sock->pcb, tcp_err_callback);
+  altcp_poll(sock->pcb, tcp_poll_callback, 4);
+  altcp_arg(sock->pcb, sock);
+
+  sock->remote_port = port;
+  sock->state = SOCKET_STATE_CONNECTING;
+
+  lwip_begin();
+  err_t err = altcp_connect(sock->pcb, (const ip_addr_t *)ip, (u16_t)port,
+                            tcp_connected_callback);
+  lwip_end();
+
+  if (err != ERR_OK) {
+    sock->state = SOCKET_STATE_ERROR;
+    sock->last_err = err;
+    return false;
+  }
+  return true;
+}
