diff --git a/thread_pthread.c b/thread_pthread.c
index d599abc..b1837a4 100644
--- a/thread_pthread.c
+++ b/thread_pthread.c
@@ -2039,6 +2039,16 @@ static void
 native_thread_init_main_thread_stack(void *addr)
 {
     native_main_thread.id = pthread_self();
+
+    /* picoruby-kernel: the main thread's stack comes from the linker script
+     * and nothing describes it. Asking pthread_getattr_np would probe for its
+     * end with mremap, which the kernel refuses, forever. Threads created
+     * later have their stacks described by pthread_create and are left to
+     * the ordinary path. */
+    native_main_thread.stack_start = addr;
+    native_main_thread.stack_maxsize = 8388608; /* 8MB, matches entry64.S */
+    return;
+
 #ifdef RUBY_ASAN_ENABLED
     addr = asan_get_real_stack_addr((void *)addr);
 #endif
