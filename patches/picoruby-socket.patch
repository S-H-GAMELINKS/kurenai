diff --git a/mrbgems/picoruby-socket/include/socket.h b/mrbgems/picoruby-socket/include/socket.h
index fc1ad11..f9b33c4 100644
--- a/mrbgems/picoruby-socket/include/socket.h
+++ b/mrbgems/picoruby-socket/include/socket.h
@@ -5,9 +5,19 @@
 #include <stdbool.h>
 #include <sys/types.h>
 
-/* Platform detection */
-#if defined(__linux__) || defined(__APPLE__) || defined(__unix__)
-  #define PICORB_PLATFORM_POSIX 1
+/* Platform detection.
+ *
+ * picoruby-kernel: sniffing __linux__ is not safe for a freestanding target.
+ * clang defines __linux__ and __unix__ from its default triple even under
+ * -ffreestanding -nostdinc, so a bare-metal build that selected the lwIP
+ * branch on the rake side would have selected the POSIX picorb_socket_t here
+ * -- two different definitions of the same struct, silently. Passing
+ * PICORB_PLATFORM_LWIP says which, and the sniff stays for builds that pass
+ * neither. */
+#if !defined(PICORB_PLATFORM_LWIP) && !defined(PICORB_PLATFORM_POSIX)
+# if defined(__linux__) || defined(__APPLE__) || defined(__unix__)
+#  define PICORB_PLATFORM_POSIX 1
+# endif
 #endif
 
 #define SOCKET_ERROR_MSG_LEN 128
@@ -64,6 +74,10 @@ typedef struct {
 extern void lwip_begin(void);
 extern void lwip_end(void);
 extern void Net_busy_wait_ms(int ms);
+/* picoruby-kernel: gives the link a turn, in place of cyw43_arch_poll. A port
+ * whose driver is not a cyw43 on SPI needs the same hook under a name that
+ * does not name somebody else's wifi chip. */
+extern void Net_poll(void);
 /* Note: ip parameter type depends on LwIP configuration (ip_addr_t in implementation) */
 extern int Net_get_ip(const char *name, void *ip);
 #endif
diff --git a/mrbgems/picoruby-socket/ports/rp2040/tcp_server.c b/mrbgems/picoruby-socket/ports/rp2040/tcp_server.c
index 6672002..3010438 100644
--- a/mrbgems/picoruby-socket/ports/rp2040/tcp_server.c
+++ b/mrbgems/picoruby-socket/ports/rp2040/tcp_server.c
@@ -15,7 +15,11 @@
 #include "lwip/ip.h"
 
 /* CYW43 includes for polling */
-#include "pico/cyw43_arch.h"
+/* picoruby-kernel: the driver here is not a cyw43 on SPI, so there is no
+ * cyw43_arch to poll. Net_poll is the port's own name for the same hook. */
+#ifndef PICO_CYW43_ARCH_POLL
+#define cyw43_arch_poll() Net_poll()
+#endif
 
 /* Pre-allocated receive buffer size for accepted TCP connections. */
 #ifndef TCP_SERVER_RECV_BUF_SIZE
@@ -74,9 +78,14 @@ tcp_recv_callback(void *arg, struct altcp_pcb *pcb, struct pbuf *pbuf, err_t err
   D("tcp_server.c tcp_recv_callback: receiving %zu bytes, current recv_len=%zu\n", total_len, sock->recv_len);
 
   if (new_size > sock->recv_capacity) {
-    /* Buffer full - cannot accept more data */
-    D("tcp_server.c tcp_recv_callback: buffer full, dropping data");
-    pbuf_free(pbuf);
+    /* Buffer full. lwIP's contract for ERR_MEM is that the pbuf has not been
+     * consumed and will be delivered again later, so freeing it here loses the
+     * data and leaves lwIP holding a pointer it intends to reuse.
+     *
+     * picoruby-kernel: keep the pbuf. TCP_WND is configured no larger than
+     * recv_capacity, which should make this unreachable -- but a receive path
+     * whose overflow behaviour is a use-after-free is not one to lean on. */
+    D("tcp_server.c tcp_recv_callback: buffer full, asking lwIP to keep it");
     return ERR_MEM;
   }
 
@@ -152,6 +161,16 @@ tcp_accept_callback(void *arg, struct altcp_pcb *newpcb, err_t err)
   sock->connected = true;
   sock->closed = false;
 
+  /* picoruby-kernel: record who connected. The memset above cleared these and
+   * nothing filled them in, so an accepted socket reported an empty host and
+   * port zero -- which is what getpeername has to answer and what an access
+   * log has to print. */
+  {
+    const ip_addr_t *peer = altcp_get_ip(newpcb, 0);
+    if (peer) ipaddr_ntoa_r(peer, sock->remote_host, sizeof(sock->remote_host));
+    sock->remote_port = altcp_get_port(newpcb, 0);
+  }
+
   /* Store in server */
   server->accepted_socket = sock;
   server->state = 1; /* has connection */
